# Copy to .env and fill in, or run ./setup.sh to generate this file.

# Public domain of your instance. DNS must point to this server.
SIVRYN_DOMAIN=chat.example.com

# Caddy provides HTTPS. Remove "caddy" if you use your own reverse proxy
# (proxy /rtc* and /twirp* to 127.0.0.1:7880, everything else to 127.0.0.1:8080).
COMPOSE_PROFILES=caddy

SIVRYN_INSTANCE_NAME=Sivryn
# open | invite_only | closed. The first account always becomes admin.
SIVRYN_REGISTRATION=invite_only

# Secrets: use long random values (openssl rand -hex 32).
POSTGRES_PASSWORD=change-me
LIVEKIT_API_KEY=sivryn
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters

# Screen share limits for this instance (defaults: 1440p60 at 12 Mbit/s).
# SIVRYN_SCREENSHARE_MAX_WIDTH=2560
# SIVRYN_SCREENSHARE_MAX_HEIGHT=1440
# SIVRYN_SCREENSHARE_MAX_FPS=60
# SIVRYN_SCREENSHARE_MAX_BITRATE=12000000
# SIVRYN_SCREENSHARE_CODECS=av1,h264

# Camera limits (defaults: 1080p60 at 8 Mbit/s).
# SIVRYN_CAMERA_MAX_WIDTH=1920
# SIVRYN_CAMERA_MAX_HEIGHT=1080
# SIVRYN_CAMERA_MAX_FPS=60
# SIVRYN_CAMERA_MAX_BITRATE=8000000

# Optional single sign-on (not functional yet, see roadmap).
# SIVRYN_OIDC_ISSUER=https://auth.example.com/application/o/sivryn/
# SIVRYN_OIDC_CLIENT_ID=
# SIVRYN_OIDC_CLIENT_SECRET=

# Optional: fan out events across several sivryn instances.
# SIVRYN_NATS_URL=nats://nats:4222

RUST_LOG=info

# Largest file people can attach to messages, in MB.
SIVRYN_MAX_UPLOAD_MB=100
